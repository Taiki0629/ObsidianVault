{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    "obsidian": {
      "command": "npx",
      "args": ["-y", "obsidian-mcp"],
      "env": { "OBSIDIAN_VAULT_PATH": "/絶対パス/to/your/vault" }
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "/絶対パス/to/your/vault"]
    }
  }
}