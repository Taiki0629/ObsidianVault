{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-8",
  "language": "japanese",
  "defaultMode": "bypassPermissions",
  "outputStyle": "Explanatory",
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": false,

  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "WebFetch",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)"
    ],
    "deny": [
      "Read(./.obsidian/workspace*.json)",
      "Read(./.trash/**)",
      "Read(./Private/**)",
      "Read(./Journal/**)",
      "Read(./**/*.env)"
    ]
  },

  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["filesystem", "fetch", "sequential-thinking"]
}